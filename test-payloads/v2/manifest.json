{
  "description": "Test pack for the /v2 common model endpoints. Run in order within a scenario; {{name}} is replaced by a saved value.",
  "scenarios": [
    {
      "id": "H1",
      "title": "Export, the whole journey, with the facility receipt",
      "steps": [
        {
          "name": "Arrange",
          "file": "happy-path/arrange-export.json",
          "method": "POST",
          "path": "/v2/movement",
          "expect": 201,
          "save": {
            "movementId": "movementId",
            "revision": "revision"
          },
          "check": {
            "status": "ARRANGED",
            "kind": "EXPORT",
            "revision": 1,
            "externalSubmissions.0.status": "NOT_ENABLED"
          }
        },
        {
          "name": "Record collection",
          "file": "happy-path/collection.json",
          "method": "POST",
          "path": "/v2/collection",
          "expect": 201,
          "save": {
            "revision": "revision"
          },
          "check": {
            "status": "COLLECTED",
            "revision": 2
          }
        },
        {
          "name": "Record delivery",
          "file": "happy-path/delivery.json",
          "method": "POST",
          "path": "/v2/delivery",
          "expect": 201,
          "save": {
            "deliveryId": "deliveries.0.deliveryId"
          },
          "check": {
            "movements.0.status": "DELIVERED"
          }
        },
        {
          "name": "Consignee receipt",
          "file": "happy-path/receipt-consignee.json",
          "method": "POST",
          "path": "/v2/receipt",
          "expect": 201,
          "check": {
            "movements.0.status": "RECEIVED"
          }
        },
        {
          "name": "Facility receipt",
          "file": "happy-path/receipt-facility.json",
          "method": "POST",
          "path": "/v2/receipt",
          "expect": 201,
          "check": {
            "fact.receivedBy": "FACILITY"
          }
        },
        {
          "name": "Read the movement",
          "method": "GET",
          "path": "/v2/movement/{{movementId}}",
          "expect": 200,
          "check": {
            "status": "RECEIVED",
            "facts.0.type": "ARRANGED",
            "facts.1.type": "COLLECTED",
            "facts.2.type": "DELIVERED",
            "facts.3.type": "RECEIVED",
            "facts.4.type": "RECEIVED"
          }
        }
      ]
    },
