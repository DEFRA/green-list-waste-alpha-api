            "revision": "revision"
          },
          "check": {
            "status": "ARRANGED",
            "externalSubmissions.0.status": "NOT_ENABLED"
          }
        },
        {
          "name": "Change the plan",
          "file": "happy-path/change-plan.json",
          "method": "PUT",
          "path": "/v2/movement/{{movementId}}",
          "headers": {
            "If-Match": "{{revision}}"
          },
          "expect": 200,
          "save": {
            "revision": "revision"
          },
          "check": {
            "status": "ARRANGED",
            "revision": 2,
            "destinationCountry": "FR"
          }
        },
        {
          "name": "Cancel",
          "file": "happy-path/cancel.json",
          "method": "PUT",
          "path": "/v2/movement/{{movementId}}",
          "headers": {
            "If-Match": "{{revision}}"
          },
          "expect": 200,
          "check": {
            "status": "CANCELLED"
          }
        }
      ]
    },
